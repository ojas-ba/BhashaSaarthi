# Keep weights in the default external Hugging Face cache.
HF_TOKEN=
DEVICE=cpu
PRECISION=float32
PARAM_MODEL=bharatgenai/Param-1-2.9B-Instruct
PARAM_REVISION=f9b32a727458727ff515fea5d82df00ae9b7ad56
TRANS_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
TRANS_REVISION=d66a2122ad6d28184f3dc3797b652bd80ae3f65f
# Local isolated IndicXlit worker; see README.
XLIT_URL=http://127.0.0.1:8765
# Windows UI can use the isolated WSL translator (no Windows Torch/C++ required).
# Start it with: wsl -d Ubuntu -- bash scripts/setup_translation.sh
TRANS_URL=http://127.0.0.1:8766
# Set only after inspecting reports/model_sources at the pinned revisions.
ALLOW_REVIEWED_REMOTE_CODE=0
MAX_INPUT_CHARS=1800
MAX_NEW_TOKENS=384
MAX_GENERATION_SECONDS=120
